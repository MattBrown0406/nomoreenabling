# Cloudflare Pages response headers.
# The unsubscribe link carries the reader's email and a token in its query;
# never send it to the next page or third parties in the Referer header.
# (Matches /unsubscribe and the /unsubscribe/ directory index.)
/unsubscribe*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
